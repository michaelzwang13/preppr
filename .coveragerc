[run]
# Coverage configuration for Preppr application

# Source code directory
source = src

# Files to include in coverage
include = src/*

# Files and directories to exclude from coverage
omit = 
    */tests/*
    */test_*
    */venv/*
    */env/*
    */__pycache__/*
    */migrations/*
    */static/*
    */templates/*
    setup.py
    app.py

# Branches to track
branch = True

# Parallel processing
parallel = True

[report]
# Reporting options
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod

# Show missing lines
show_missing = True

# Skip covered files
skip_covered = False

# Precision for percentages
precision = 2

# Sort by coverage percentage
sort = Cover

[html]
# HTML report options
directory = htmlcov
title = Preppr Test Coverage Report

[xml]
# XML report options
output = coverage.xml

[json]
# JSON report options
output = coverage.json